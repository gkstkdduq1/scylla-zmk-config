/*
 * Scylla MK2 — keymap ported from gkstkdduq1/zmk-config (2023).
 *
 * IMPORTANT: once you save anything in ZMK Studio, the keyboard runs from
 * settings stored in flash and IGNORES this file. Later edits here do nothing
 * until you run "Restore Stock Settings" in Studio. This file is the seed and
 * the fallback; day-to-day remapping happens in Studio.
 *
 * Added on top of the original keymap:
 *   lower + bottom-left corner key  -> &studio_unlock  (unlocks Studio writes)
 *   lower + bottom-right corner key -> &bootloader     (flash mode, no reset button)
 *
 * Spare 1/2/3 are all-&trans placeholder layers. ZMK Studio cannot create new
 * layers at runtime, only edit ones the firmware already defines — so these
 * exist purely to give Studio room to work with later.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
// ---------------------------------------------------------------------------------------------
// | ESC  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |  -   |
// | CAPS |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
// | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  |  \   |
//              | LOWER | SPACE | LSHFT |   | RSHFT | ENTER | RAISE |
//                      | HOME  | LGUI  |   | LALT  | END   |
            bindings = <
   &kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5       &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp BSPC
   &kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T        &kp Y   &kp U   &kp I      &kp O    &kp P     &kp MINUS
   &kp CAPS   &kp A   &kp S   &kp D   &kp F   &kp G        &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
   &kp LCTRL  &kp Z   &kp X   &kp C   &kp V   &kp B        &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                      &mo 1     &kp SPACE  &kp LSHIFT      &kp RSHIFT  &kp RET   &mo 2
                                &kp HOME   &kp LGUI        &kp LALT    &kp END
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
   &out OUT_TOG    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp N6     &kp N7     &kp N8    &kp N9    &kp N0    &kp BSPC
   &bt BT_CLR      &trans        &trans        &kp UP        &trans        &trans          &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
   &kp LSHFT       &trans        &kp LEFT      &kp DOWN      &kp RIGHT     &trans          &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
   &studio_unlock  &trans        &trans        &trans        &trans        &trans          &trans     &trans     &trans    &trans    &trans    &bootloader
                                 &trans     &trans      &trans            &trans     &trans     &trans
                                            &kp BSPC   &kp LANG1         &kp LALT   &kp DEL
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
   &kp F12  &kp F1  &kp F2      &kp F3            &kp F4      &kp F5     &kp F6          &kp F7     &kp F8     &kp F9     &kp F10          &kp F11
   &trans   &trans  &trans      &kp C_VOL_UP      &trans      &trans     &kp KP_NUMLOCK  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp BSLH         &trans
   &trans   &trans  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &trans     &trans          &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MULTIPLY  &trans
   &trans   &trans  &trans      &kp C_VOL_DN      &trans      &trans     &kp KP_N0       &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_PLUS      &trans
                    &trans    &trans     &trans                &trans    &trans    &trans
                              &kp BSPC  &kp LANG1              &kp LALT  &kp DEL
            >;
        };

        spare_1_layer {
            display-name = "Spare 1";
            bindings = <
   &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
   &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
   &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
   &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
                   &trans  &trans  &trans               &trans  &trans  &trans
                           &trans  &trans               &trans  &trans
            >;
        };

        spare_2_layer {
            display-name = "Spare 2";
            bindings = <
   &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
   &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
   &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
   &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
                   &trans  &trans  &trans               &trans  &trans  &trans
                           &trans  &trans               &trans  &trans
            >;
        };

        spare_3_layer {
            display-name = "Spare 3";
            bindings = <
   &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
   &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
   &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
   &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
                   &trans  &trans  &trans               &trans  &trans  &trans
                           &trans  &trans               &trans  &trans
            >;
        };
    };
};
